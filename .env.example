OPENROUTER_API_KEY=sk-or-v1-your-old-key-here
OPENAI_API_KEY=sk-your-old-key-here
COMPOSIO_API_KEY=your-composio-api-key-here

# Gemini Live API (replaces OpenRouter for real-time AI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest

# Tailscale Remote Control (optional)
TAILSCALE_ENABLED=true
TAILSCALE_SERVER_PORT=8765
TSCALE_AUTH_KEY=tskey-your-auth-key-here